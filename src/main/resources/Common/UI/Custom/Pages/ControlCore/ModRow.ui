$C = "../../Common.ui";

@BadgeOn = (FontSize: 11, TextColor: #f2efe6, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
@BadgeOff = (FontSize: 11, TextColor: #5f7383, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);

Group {
  LayoutMode: Top;
  Padding: (Top: 10);

  Group {
    LayoutMode: Left;

    Group #ModLogo {
      Anchor: (Width: 56, Height: 56, Right: 12);
      Background: "../../ControlCore_ModIcon.png";
    }

    Group {
      LayoutMode: Top;
      FlexWeight: 1;

      Group {
        LayoutMode: Left;
        Anchor: (Height: 22);

        Label #Name {
          Style: (...$C.@DefaultLabelStyle, RenderBold: true, FontSize: 16, TextColor: #e9e4d6, VerticalAlignment: Center);
          Anchor: (Right: 10);
        }

        Label #Version {
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9fb0bd, VerticalAlignment: Center);
          Anchor: (Right: 10);
        }

        Label #BadgeCode {
          Anchor: (Height: 20, Top: 1, Right: 4);
          Padding: (Horizontal: 7);
          Background: #2f5d8a;
          Style: @BadgeOn;
        }

        Label #BadgeNoCode {
          Visible: false;
          Anchor: (Height: 20, Top: 1, Right: 4);
          Padding: (Horizontal: 7);
          Background: #1b2c38;
          Style: @BadgeOff;
        }

        Label #BadgeAssets {
          Anchor: (Height: 20, Top: 1, Right: 4);
          Padding: (Horizontal: 7);
          Background: #3f6e3c;
          Style: @BadgeOn;
        }

        Label #BadgeNoAssets {
          Visible: false;
          Anchor: (Height: 20, Top: 1, Right: 4);
          Padding: (Horizontal: 7);
          Background: #1b2c38;
          Style: @BadgeOff;
        }

        Label #BadgeOff {
          Visible: false;
          Anchor: (Height: 20, Top: 1, Left: 6, Right: 4);
          Padding: (Horizontal: 7);
          Background: #4a5866;
          Style: @BadgeOn;
        }

        Label #BadgeFailed {
          Visible: false;
          Anchor: (Height: 20, Top: 1, Left: 6, Right: 4);
          Padding: (Horizontal: 7);
          Background: #9c4434;
          Style: @BadgeOn;
        }

        Label #BadgeRestart {
          Visible: false;
          Anchor: (Height: 20, Top: 1, Left: 6, Right: 4);
          Padding: (Horizontal: 7);
          Background: #2a4f6e;
          Style: (...@BadgeOn, TextColor: #a9d1f2);
        }

        Label #BadgeMissing {
          Visible: false;
          Anchor: (Height: 20, Top: 1, Left: 6, Right: 4);
          Padding: (Horizontal: 7);
          Background: #9c4434;
          Style: @BadgeOn;
        }

        Label #BadgeWrongVersion {
          Visible: false;
          Anchor: (Height: 20, Top: 1, Left: 6, Right: 4);
          Padding: (Horizontal: 7);
          Background: #8a5a1c;
          Style: @BadgeOn;
        }

        Label #BadgeNeeded {
          Visible: false;
          Anchor: (Height: 20, Top: 1, Left: 6, Right: 4);
          Padding: (Horizontal: 7);
          Background: #34495a;
          Style: (...@BadgeOn, TextColor: #c9d6e0);
        }

        Label #BadgeHytale {
          Visible: false;
          Anchor: (Height: 20, Top: 1, Left: 6, Right: 4);
          Padding: (Horizontal: 7);
          Background: #6b5422;
          Style: (...@BadgeOn, TextColor: #f2d69a);
        }
      }

      Label #Description {
        Anchor: (Top: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #c9c3b3, Wrap: true);
      }

      Label #Details {
        Anchor: (Top: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9fb0bd, Wrap: true);
      }

      Label #Needs {
        Visible: false;
        Anchor: (Top: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9fb0bd, Wrap: true);
      }

      Label #Problem {
        Visible: false;
        Anchor: (Top: 2);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #e07a5f, Wrap: true);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 32, Top: 6);

        $C.@SmallSecondaryTextButton #Settings {
          @Text = %controlcore.ui.mods.settings;
          Anchor: (Width: 150, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #Keys {
          @Text = %controlcore.ui.mods.keys;
          Anchor: (Width: 100, Height: 30, Right: 6);
        }

        $C.@SmallTertiaryTextButton #Config {
          @Text = %controlcore.ui.mods.config;
          Anchor: (Width: 190, Height: 30, Right: 6);
        }

        Group {
          FlexWeight: 1;
        }

        Group #EnabledBox {
          LayoutMode: Left;
          Anchor: (Height: 30);

          Label {
            Text: %controlcore.ui.mods.enabled;
            Style: (...$C.@DefaultLabelStyle, TextColor: #c9c3b3, VerticalAlignment: Center);
            Anchor: (Right: 8);
          }

          $C.@CheckBox #Enabled {
            Anchor: (Width: 26, Height: 26, Top: 2);
          }
        }
      }
    }
  }

  Label #ConfigText {
    Visible: false;
    Anchor: (Left: 68, Top: 8);
    Padding: (Full: 8);
    Background: #13202a;
    Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #c9c3b3, Wrap: true);
  }

  Group {
    Anchor: (Height: 1, Top: 10);
    Background: #263c4c;
  }
}

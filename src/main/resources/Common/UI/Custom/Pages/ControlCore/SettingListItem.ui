$C = "../../Common.ui";

Group {
  LayoutMode: Left;
  Anchor: (Height: 30, Bottom: 2);

  Label #Text {
    FlexWeight: 1;
    Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
  }

  $C.@SmallTertiaryTextButton #Remove {
    @Text = %controlcore.ui.remove;
    Anchor: (Width: 106, Height: 28, Left: 6);
  }
}

$C = "../../Common.ui";

@Text = (FontSize: 14, TextColor: #e9e4d6);
@Muted = (FontSize: 13, TextColor: #9fb0bd, Wrap: true);
@Glyphs = (FontSize: 18, TextColor: #e9e4d6);
@Heading = (FontSize: 13, TextColor: #c9c3b3, RenderBold: true, RenderUppercase: true);

@TabLabel = (FontSize: 14, TextColor: #9fb0bd);
@TabLabelOn = (FontSize: 14, TextColor: #e9e4d6, RenderBold: true);

@TabStyle = TextButtonStyle(
  Default: (Background: #162733, LabelStyle: @TabLabel),
  Hovered: (Background: #1d3140, LabelStyle: @TabLabel),
  Pressed: (Background: #1d3140, LabelStyle: @TabLabel)
);

@SelectedTabStyle = TextButtonStyle(
  Default: (Background: #1d3140, LabelStyle: @TabLabelOn),
  Hovered: (Background: #1d3140, LabelStyle: @TabLabelOn),
  Pressed: (Background: #1d3140, LabelStyle: @TabLabelOn)
);

@LegendStyle = TextButtonStyle(
  Default: (Background: #182a37, LabelStyle: @Text),
  Hovered: (Background: #223a4b, LabelStyle: @Text),
  Pressed: (Background: #2a3a3a, LabelStyle: @Text)
);

@LegendOnStyle = TextButtonStyle(
  Default: (Background: #2a3a3a, LabelStyle: @TabLabelOn),
  Hovered: (Background: #2a3a3a, LabelStyle: @TabLabelOn),
  Pressed: (Background: #2a3a3a, LabelStyle: @TabLabelOn)
);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group {
    Anchor: (Width: 760);
    LayoutMode: Top;
    Background: #13202a;
    Padding: (Full: 16);

    Label { Text: "ControlCore UI test"; Style: (FontSize: 18, TextColor: #e9e4d6, RenderBold: true); Anchor: (Bottom: 10); }

    Label { Text: "1. Symbols (do they all draw?)"; Style: @Heading; Anchor: (Bottom: 4); }
    Label { Text: "A  ◆ ◇ ◐ ✕ ⟳ ▦ ● ↶ ▾ ★ ■ □"; Style: @Glyphs; }
    Label { Text: "B  ♦ ○ ◑ × ↻ ▩ • ← ▼ ☆ ▪ ▫"; Style: @Glyphs; }
    Label { Text: "C  * o ~ x ! # + < v"; Style: @Glyphs; Anchor: (Bottom: 12); }

    Label { Text: "2. Tabs (click one: does it get the selected look?)"; Style: @Heading; Anchor: (Bottom: 4); }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 36);
      TextButton #TabA { Text: "Server Configs"; Style: @SelectedTabStyle; Anchor: (Width: 160, Right: 4); }
      TextButton #TabB { Text: "Config. de mods"; Style: @TabStyle; Anchor: (Width: 160, Right: 4); }
      TextButton #TabC { Text: "Permissões"; Style: @TabStyle; Anchor: (Width: 160); }
    }
    Group { Anchor: (Height: 3, Width: 160, Bottom: 12); Background: #e8a93b; }

    Label { Text: "3. Typing (type without pressing Save: does the line change?)"; Style: @Heading; Anchor: (Bottom: 4); }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 38);
      $C.@TextField #Field { Anchor: (Width: 420, Right: 8); }
      $C.@SmallSecondaryTextButton #SaveButton { @Text = "Save"; }
    }
    Label #FieldState { Text: "saved"; Style: @Muted; Anchor: (Top: 4, Bottom: 12); }

    Label { Text: "4. Legend filters (click: highlight + count)"; Style: @Heading; Anchor: (Bottom: 4); }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 32, Bottom: 6);
      TextButton #LegendAll { Text: "* All 27"; Style: @LegendOnStyle; Anchor: (Width: 120, Right: 4); }
      TextButton #LegendChanged { Text: "◆ Changed 2"; Style: @LegendStyle; Anchor: (Width: 150, Right: 4); }
      TextButton #LegendRestart { Text: "⟳ Restart 2"; Style: @LegendStyle; Anchor: (Width: 150); }
    }
    Label #LegendState { Text: "showing: all"; Style: @Muted; Anchor: (Bottom: 12); }

    Label { Text: "5. Colours"; Style: @Heading; Anchor: (Bottom: 4); }
    Group {
      LayoutMode: Left;
      Anchor: (Height: 28, Bottom: 14);
      Group { Anchor: (Width: 60, Right: 4); Background: #1d3140; }
      Group { Anchor: (Width: 60, Right: 4); Background: #e8a93b; }
      Group { Anchor: (Width: 60, Right: 4); Background: #e3b37a; }
      Group { Anchor: (Width: 60, Right: 4); Background: #e39a52; }
      Group { Anchor: (Width: 60, Right: 4); Background: #e88a72; }
      Group { Anchor: (Width: 60, Right: 4); Background: #7fb2e0; }
      Group { Anchor: (Width: 60); Background: #7fbf6a; }
    }

    $C.@SmallSecondaryTextButton #CloseButton { @Text = "Close"; }
  }
}

$C.@BackButton {}

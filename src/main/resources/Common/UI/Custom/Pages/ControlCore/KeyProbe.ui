$C = "../../Common.ui";

@NoteStyle = (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #878e9c, Wrap: true);
@StatusStyle = (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #E8A93B, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 560);

    #Title {
      $C.@Title {
        @Text = "Key test";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Group #KeyRoot {
        LayoutMode: Top;

        Label #Hint {
          Text: "Press keys. Everything this screen reports appears below, in chat and in the server log.";
          Style: @NoteStyle;
          Anchor: (Bottom: 10);
        }

        $C.@TextField #KeyInput {
          Anchor: (Height: 34, Bottom: 10);
        }

        Label #Status {
          Text: "";
          Style: @StatusStyle;
        }
      }

      Group {
        Anchor: (Vertical: 14, Height: 1);
        Background: #5e512c;
      }

      $C.@TextButton #CloseButton {
        Text: "Close";
      }
    }
  }
}

$C.@BackButton {}

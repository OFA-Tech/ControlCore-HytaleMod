$C = "../../Common.ui";

Group {
  LayoutMode: Top;
  Padding: (Top: 8, Bottom: 0);

  Group {
    LayoutMode: Left;
    Anchor: (Height: 40);

    Group #AvatarBox {
      Anchor: (Width: 36, Height: 36, Top: 2, Right: 12);

      Group #Avatar0 {
        Anchor: (Full: 0);
        Background: #2f5d8a;
        Visible: true;
      }

      Group #Avatar1 {
        Anchor: (Full: 0);
        Background: #3f6e3c;
        Visible: false;
      }

      Group #Avatar2 {
        Anchor: (Full: 0);
        Background: #6b5422;
        Visible: false;
      }

      Group #Avatar3 {
        Anchor: (Full: 0);
        Background: #7a3e5c;
        Visible: false;
      }

      Group #Avatar4 {
        Anchor: (Full: 0);
        Background: #2a6b6b;
        Visible: false;
      }

      Group #Avatar5 {
        Anchor: (Full: 0);
        Background: #5a4a8a;
        Visible: false;
      }

      Group #Avatar6 {
        Anchor: (Full: 0);
        Background: #8a5a2f;
        Visible: false;
      }

      Group #Avatar7 {
        Anchor: (Full: 0);
        Background: #4a5866;
        Visible: false;
      }

      Label #Initial {
        Anchor: (Full: 0);
        Style: (...$C.@DefaultLabelStyle, FontSize: 18, TextColor: #f2efe6, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    Label #Name {
      FlexWeight: 1;
      Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #e9e4d6, RenderBold: true, VerticalAlignment: Center);
    }

    Label #Expired {
      Text: %controlcore.ui.bans.expired;
      Visible: false;
      Anchor: (Height: 22, Top: 9, Right: 8);
      Padding: (Horizontal: 8);
      Background: #4a5866;
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #f2efe6, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
    }

    $C.@SmallTertiaryTextButton #Unban {
      @Text = %controlcore.ui.bans.unban;
      Anchor: (Width: 150, Height: 32, Top: 4, Left: 6);
    }
  }

  Label #Details {
    Anchor: (Left: 48, Top: 1);
    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9fb0bd, Wrap: true);
  }

  Group {
    Anchor: (Height: 1, Top: 9);
    Background: #263c4c;
  }
}

$C = "../../Common.ui";

@SectionTitleStyle = (...$C.@DefaultLabelStyle, RenderBold: true, FontSize: 18);
@SubsectionTitleStyle = (...$C.@DefaultLabelStyle, RenderBold: true, RenderUppercase: true, FontSize: 13, TextColor: #878e9c);
@NoteStyle = (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #878e9c, Wrap: true);
@RowLabelStyle = (...$C.@DefaultLabelStyle, RenderBold: true, VerticalAlignment: Center);
@RowValueStyle = (...$C.@DefaultLabelStyle, VerticalAlignment: Center, Wrap: true);
@StatusStyle = (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #E8A93B, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 760);

    #Title {
      $C.@Title {
        @Text = %controlcore.ui.title;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Group #TabButtons {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 14);

        $C.@SmallSecondaryTextButton #ServerTabButton {
          @Text = %controlcore.ui.tabs.serverConfigs;
          Anchor: (Width: 132, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #SettingsTabButton {
          @Text = %controlcore.ui.tabs.modSettings;
          Anchor: (Width: 132, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #PlayerTabButton {
          @Text = %controlcore.ui.tabs.playerPrefs;
          Anchor: (Width: 132, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #KeymapTabButton {
          @Text = %controlcore.ui.tabs.keymaps;
          Anchor: (Width: 132, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #ModsTabButton {
          @Text = %controlcore.ui.tabs.mods;
          Anchor: (Width: 132, Height: 30, Right: 6);
        }
      }

      Group #ServerTab {
        LayoutMode: Top;

        Label {
          Text: %controlcore.ui.server.title;
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: %controlcore.ui.server.intro;
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Label #ServerRestart {
          Style: @StatusStyle;
          Visible: false;
          Anchor: (Bottom: 8);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 34, Bottom: 8);

          $C.@DropdownBox #ServerSearchFilter {
            Anchor: (Width: 150, Right: 6);
          }

          $C.@DropdownBox #ServerSearchMatch {
            Anchor: (Width: 170, Right: 6);
          }

          $C.@TextField #ServerSearch {
            FlexWeight: 1;
          }
        }

        Label #ServerStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #ServerList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 298);
          Padding: (Right: 10);
        }
      }

      Group #SettingsTab {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: %controlcore.ui.tabs.modSettings;
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: %controlcore.ui.settings.intro;
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 34, Bottom: 8);

          $C.@DropdownBox #SettingsSearchFilter {
            Anchor: (Width: 150, Right: 6);
          }

          $C.@DropdownBox #SettingsSearchMatch {
            Anchor: (Width: 170, Right: 6);
          }

          $C.@TextField #SettingsSearch {
            FlexWeight: 1;
          }
        }

        Label #SettingsStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #SettingsList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 298);
          Padding: (Right: 10);
        }
      }

      Group #PlayerTab {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: %controlcore.ui.prefs.title;
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: %controlcore.ui.prefs.intro;
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 34, Bottom: 8);

          $C.@DropdownBox #PlayerSearchFilter {
            Anchor: (Width: 150, Right: 6);
          }

          $C.@DropdownBox #PlayerSearchMatch {
            Anchor: (Width: 170, Right: 6);
          }

          $C.@TextField #PlayerSearch {
            FlexWeight: 1;
          }
        }

        Label #PlayerStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #PlayerList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 298);
          Padding: (Right: 10);
        }
      }

      Group #KeymapTab {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: %controlcore.ui.tabs.keymaps;
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Group #KeymapModeButtons {
          LayoutMode: Left;
          Visible: false;
          Anchor: (Height: 34, Bottom: 8);

          $C.@SmallSecondaryTextButton #KeymapModeServer {
            @Text = %controlcore.ui.keymaps.modeServer;
            Anchor: (Width: 170, Height: 32, Right: 6);
          }

          $C.@SmallSecondaryTextButton #KeymapModeMine {
            @Text = %controlcore.ui.keymaps.modeMine;
            Anchor: (Width: 120, Height: 32);
          }
        }

        Group #ServerKeymaps {
          LayoutMode: Top;
          Visible: false;

          Label {
            Text: %controlcore.ui.keymaps.serverIntro;
            Style: @NoteStyle;
            Anchor: (Bottom: 8);
          }

          Group #CustomBindForm {
            LayoutMode: Top;
            Anchor: (Bottom: 8);

            Group {
              LayoutMode: Left;
              Anchor: (Height: 38);

              $C.@TextField #NewBindName {
                Anchor: (Width: 150, Right: 6);
              }

              $C.@TextField #NewBindKeys {
                Anchor: (Width: 140, Right: 6);
              }

              $C.@TextField #NewBindCommand {
                FlexWeight: 1;
              }
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 34, Top: 4);

              $C.@CheckBox #NewBindAsServer {
                Anchor: (Width: 26, Height: 26, Right: 8);
              }

              Label {
                Text: %controlcore.ui.bind.asServer;
                FlexWeight: 1;
                Style: @NoteStyle;
              }

              $C.@SmallSecondaryTextButton #NewBindAdd {
                @Text = %controlcore.ui.bind.save;
                Anchor: (Width: 110, Height: 32, Left: 6);
              }
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 34, Bottom: 8);

            $C.@DropdownBox #ServerKeymapSearchFilter {
              Anchor: (Width: 150, Right: 6);
            }

            $C.@DropdownBox #ServerKeymapSearchMatch {
              Anchor: (Width: 170, Right: 6);
            }

            $C.@TextField #ServerKeymapSearch {
              FlexWeight: 1;
            }
          }

          Label #ServerKeymapStatus {
            Style: @StatusStyle;
            Anchor: (Bottom: 8);
          }

          Group #ServerKeymapList {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Anchor: (Height: 178);
            Padding: (Right: 10);
          }
        }

        Group #MyKeymaps {
          LayoutMode: Top;

          Label {
            Text: %controlcore.ui.keymaps.mineIntro;
            Style: @NoteStyle;
            Anchor: (Bottom: 8);
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 34, Bottom: 8);

            $C.@DropdownBox #KeymapSearchFilter {
              Anchor: (Width: 150, Right: 6);
            }

            $C.@DropdownBox #KeymapSearchMatch {
              Anchor: (Width: 170, Right: 6);
            }

            $C.@TextField #KeymapSearch {
              FlexWeight: 1;
            }
          }

          Label #KeymapStatus {
            Style: @StatusStyle;
            Anchor: (Bottom: 8);
          }

          Group #KeymapList {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Anchor: (Height: 258);
            Padding: (Right: 10);
          }
        }
      }

      Group #ModsTab {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: %controlcore.ui.tabs.mods;
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: %controlcore.ui.mods.intro;
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 34, Bottom: 8);

          $C.@DropdownBox #ModsSearchFilter {
            Anchor: (Width: 220, Right: 6);
          }

          $C.@TextField #ModsSearch {
            FlexWeight: 1;
          }
        }

        Label #ModsStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #ModsList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 298);
          Padding: (Right: 10);
        }
      }

      Group {
        Anchor: (Vertical: 14, Height: 1);
        Background: #5e512c;
      }

      $C.@TextButton #CloseButton {
        Text: %controlcore.ui.close;
      }
    }
  }
}

$C.@BackButton {}

$C = "../../Common.ui";

@SubsectionTitleStyle = (...$C.@DefaultLabelStyle, RenderBold: true, RenderUppercase: true, FontSize: 13, TextColor: #9fb0bd);
@NoteStyle = (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9fb0bd, Wrap: true);
@RowLabelStyle = (...$C.@DefaultLabelStyle, RenderBold: true, VerticalAlignment: Center);
@RowValueStyle = (...$C.@DefaultLabelStyle, VerticalAlignment: Center, Wrap: true);
@StatusStyle = (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #e8a93b, Wrap: true);
@HealthValueStyle = (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #e9e4d6, VerticalAlignment: Center);
@HealthWarnStyle = (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #e88a72, RenderBold: true, VerticalAlignment: Center);
@CountStyle = (FontSize: 13, TextColor: #9fb0bd, VerticalAlignment: Center, HorizontalAlignment: End);

@TitleStyle = (FontSize: 18, TextColor: #e9e4d6, RenderBold: true, VerticalAlignment: Center);
@BrandStyle = (FontSize: 13, TextColor: #9fb0bd, VerticalAlignment: Center);
@BannerStyle = (FontSize: 14, TextColor: #e9e4d6, VerticalAlignment: Center, Wrap: true);
@FooterStyle = (FontSize: 13, TextColor: #9fb0bd, VerticalAlignment: Center);

@TabLabel = (FontSize: 13, TextColor: #9fb0bd, VerticalAlignment: Center, HorizontalAlignment: Center);
@TabLabelOn = (FontSize: 13, TextColor: #e9e4d6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: Center);

@TabStyle = TextButtonStyle(
  Default: (Background: #162733, LabelStyle: @TabLabel),
  Hovered: (Background: #1d3140, LabelStyle: @TabLabel),
  Pressed: (Background: #1d3140, LabelStyle: @TabLabel)
);

@LegendLabel = (FontSize: 14, TextColor: #c9c3b3, VerticalAlignment: Center, HorizontalAlignment: Start);
@LegendLabelOn = (FontSize: 14, TextColor: #e9e4d6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: Start);

@LegendStyle = TextButtonStyle(
  Default: (Background: #182a37, LabelStyle: @LegendLabel),
  Hovered: (Background: #223a4b, LabelStyle: @LegendLabel),
  Pressed: (Background: #223a4b, LabelStyle: @LegendLabel)
);

@LegendOnStyle = TextButtonStyle(
  Default: (Background: #2c4252, LabelStyle: @LegendLabelOn),
  Hovered: (Background: #2c4252, LabelStyle: @LegendLabelOn),
  Pressed: (Background: #2c4252, LabelStyle: @LegendLabelOn)
);

@SegmentStyle = TextButtonStyle(
  Default: (Background: #162733, LabelStyle: @TabLabel),
  Hovered: (Background: #223a4b, LabelStyle: @TabLabel),
  Pressed: (Background: #223a4b, LabelStyle: @TabLabel)
);

@SegmentOnStyle = TextButtonStyle(
  Default: (Background: #2c4252, LabelStyle: @TabLabelOn),
  Hovered: (Background: #2c4252, LabelStyle: @TabLabelOn),
  Pressed: (Background: #2c4252, LabelStyle: @TabLabelOn)
);

@SelectedTabStyle = TextButtonStyle(
  Default: (Background: #1d3140, LabelStyle: @TabLabelOn),
  Hovered: (Background: #1d3140, LabelStyle: @TabLabelOn),
  Pressed: (Background: #1d3140, LabelStyle: @TabLabelOn)
);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group {
    Anchor: (Width: 1320);
    LayoutMode: Top;
    Background: #2c4252;
    Padding: (Full: 1);

    Group #Frame {
      LayoutMode: Top;
      Background: #13202a;

      Group #TitleBar {
        LayoutMode: Left;
        Anchor: (Height: 48);
        Padding: (Horizontal: 20);

        Label {
          Text: %controlcore.ui.title;
          Style: @TitleStyle;
          Anchor: (Width: 132);
        }

        Label {
          Text: "OFA-Tech";
          Style: @BrandStyle;
          FlexWeight: 1;
        }
      }

      Group #TabButtons {
        LayoutMode: Left;
        Anchor: (Height: 38);
        Padding: (Horizontal: 16);

          Group #ServerTabSlot {
            LayoutMode: Top;
            Anchor: (Width: 139, Right: 4);

            Group #ServerTabEdge {
              Anchor: (Height: 3);
              Background: #e8a93b;
              Visible: false;
            }

            TextButton #ServerTabButton {
              Text: %controlcore.ui.tabs.serverConfigs;
              Style: @TabStyle;
              Anchor: (Height: 35);
            }
          }

          Group #SettingsTabSlot {
            LayoutMode: Top;
            Anchor: (Width: 139, Right: 4);

            Group #SettingsTabEdge {
              Anchor: (Height: 3);
              Background: #e8a93b;
              Visible: false;
            }

            TextButton #SettingsTabButton {
              Text: %controlcore.ui.tabs.modSettings;
              Style: @TabStyle;
              Anchor: (Height: 35);
            }
          }

          Group #PlayerTabSlot {
            LayoutMode: Top;
            Anchor: (Width: 139, Right: 4);

            Group #PlayerTabEdge {
              Anchor: (Height: 3);
              Background: #e8a93b;
              Visible: false;
            }

            TextButton #PlayerTabButton {
              Text: %controlcore.ui.tabs.playerPrefs;
              Style: @TabStyle;
              Anchor: (Height: 35);
            }
          }

          Group #KeymapTabSlot {
            LayoutMode: Top;
            Anchor: (Width: 139, Right: 4);

            Group #KeymapTabEdge {
              Anchor: (Height: 3);
              Background: #e8a93b;
              Visible: false;
            }

            TextButton #KeymapTabButton {
              Text: %controlcore.ui.tabs.keymaps;
              Style: @TabStyle;
              Anchor: (Height: 35);
            }
          }

          Group #ModsTabSlot {
            LayoutMode: Top;
            Anchor: (Width: 139, Right: 4);

            Group #ModsTabEdge {
              Anchor: (Height: 3);
              Background: #e8a93b;
              Visible: false;
            }

            TextButton #ModsTabButton {
              Text: %controlcore.ui.tabs.mods;
              Style: @TabStyle;
              Anchor: (Height: 35);
            }
          }

          Group #PermissionsTabSlot {
            LayoutMode: Top;
            Anchor: (Width: 139, Right: 4);

            Group #PermissionsTabEdge {
              Anchor: (Height: 3);
              Background: #e8a93b;
              Visible: false;
            }

            TextButton #PermissionsTabButton {
              Text: %controlcore.ui.tabs.permissions;
              Style: @TabStyle;
              Anchor: (Height: 35);
            }
          }

          Group #HistoryTabSlot {
            LayoutMode: Top;
            Anchor: (Width: 139, Right: 4);

            Group #HistoryTabEdge {
              Anchor: (Height: 3);
              Background: #e8a93b;
              Visible: false;
            }

            TextButton #HistoryTabButton {
              Text: %controlcore.ui.tabs.history;
              Style: @TabStyle;
              Anchor: (Height: 35);
            }
          }
        Group #HealthTabSlot {
            LayoutMode: Top;
            Anchor: (Width: 139, Right: 4);

            Group #HealthTabEdge {
              Anchor: (Height: 3);
              Background: #e8a93b;
              Visible: false;
            }

            TextButton #HealthTabButton {
              Text: %controlcore.ui.tabs.health;
              Style: @TabStyle;
              Anchor: (Height: 35);
            }
          }
        Group #AutomationTabSlot {
            LayoutMode: Top;
            Anchor: (Width: 139);

            Group #AutomationTabEdge {
              Anchor: (Height: 3);
              Background: #e8a93b;
              Visible: false;
            }

            TextButton #AutomationTabButton {
              Text: %controlcore.ui.tabs.automation;
              Style: @TabStyle;
              Anchor: (Height: 35);
            }
          }
      }

      Group #Body {
        LayoutMode: Top;
        Background: #1d3140;
        Padding: (Full: 16);

        Group #RestartBanner {
          LayoutMode: Left;
          Visible: false;
          Anchor: (Height: 36, Bottom: 10);
          Background: #1b2f44;
          Padding: (Horizontal: 10);

          Group {
            Anchor: (Width: 4, Right: 10);
            Background: #7fb2e0;
          }

          Group {
            Anchor: (Width: 18, Height: 18, Top: 9, Right: 10);
            Background: "Icons/Restart.png";
          }

          Label #RestartText {
            Style: @BannerStyle;
            FlexWeight: 1;
          }
        }

        Group #Columns {
          LayoutMode: Left;

          Group #Tabs {
            LayoutMode: Top;
            FlexWeight: 1;

          Group #ServerTab {
            LayoutMode: Top;

            Group #ServerModeButtons {
              LayoutMode: Left;
              Visible: false;
              Anchor: (Height: 32, Bottom: 8);

              TextButton #ServerModeConfig {
                Text: %controlcore.ui.server.modeConfig;
                Style: @SegmentStyle;
                Anchor: (Width: 180, Right: 2);
              }

              TextButton #ServerModeWorlds {
                Text: %controlcore.ui.server.modeWorlds;
                Style: @SegmentStyle;
                Anchor: (Width: 180, Right: 2);
              }

              TextButton #ServerModeBans {
                Text: %controlcore.ui.server.modeBans;
                Style: @SegmentStyle;
                Anchor: (Width: 180, Right: 12);
              }

              $C.@DropdownBox #ServerWorld {
                Visible: false;
                Anchor: (Width: 220);
              }
            }

            Label #ServerIntro {
              Text: %controlcore.ui.server.intro;
              Style: @NoteStyle;
              Anchor: (Bottom: 8);
            }

            Label #WorldsIntro {
              Text: %controlcore.ui.server.worldsIntro;
              Style: @NoteStyle;
              Visible: false;
              Anchor: (Bottom: 8);
            }

            Group #ServerRows {
            LayoutMode: Top;

            Group {
              LayoutMode: Left;
              Anchor: (Height: 34, Bottom: 8);

              $C.@DropdownBox #ServerSearchFilter {
                Anchor: (Width: 150, Right: 6);
              }

              $C.@DropdownBox #ServerSearchMatch {
                Anchor: (Width: 170, Right: 6);
              }

              $C.@TextField #ServerSearch {
                FlexWeight: 1;
              }

              Label #ServerStatus {
                Style: @CountStyle;
                Anchor: (Width: 120, Left: 10);
              }

              $C.@SmallTertiaryTextButton #ServerSearchDefaults {
                @Text = %controlcore.ui.restoreDefaults;
                Anchor: (Width: 190, Height: 32, Left: 6);
              }
            }


            Group #ServerList {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              Anchor: (Height: 580);
              Padding: (Right: 10);
            }
            }

            Group #BansPanel {
              LayoutMode: Top;
              Visible: false;

              Label {
                Text: %controlcore.ui.bans.intro;
                Style: @NoteStyle;
                Anchor: (Bottom: 8);
              }

              Group #BanForm {
                LayoutMode: Top;
                Visible: false;
                Anchor: (Bottom: 10);
                Background: #182a37;
                Padding: (Full: 10);

                Group {
                  LayoutMode: Left;
                  Anchor: (Height: 30, Bottom: 6);

                  Label {
                    Text: %controlcore.ui.players.actionTitle;
                    Style: @SubsectionTitleStyle;
                    FlexWeight: 1;
                  }

                  $C.@SmallTertiaryTextButton #PlayerActionClose {
                    @Text = %controlcore.ui.players.closeForm;
                    Anchor: (Width: 150, Height: 30);
                  }
                }

                Group {
                  LayoutMode: Left;
                  Anchor: (Height: 38);

                  $C.@DropdownBox #PlayerActionKind {
                    Anchor: (Width: 230, Right: 6);
                  }

                  $C.@DropdownBox #PlayerActionGroup {
                    Visible: false;
                    Anchor: (Width: 180, Right: 6);
                  }

                  $C.@TextField #BanPlayer {
                    Anchor: (Width: 220, Right: 6);
                  }

                  $C.@DropdownBox #BanLength {
                    Anchor: (Width: 170, Right: 6);
                  }

                  $C.@TextField #BanReason {
                    FlexWeight: 1;
                  }

                  $C.@SmallSecondaryTextButton #BanAdd {
                    @Text = %controlcore.ui.players.apply;
                    Anchor: (Width: 130, Height: 34, Left: 6);
                  }
                }

                Label #PlayerActionNote {
                  Visible: false;
                  Style: (...@NoteStyle, Wrap: true);
                  Anchor: (Top: 6);
                }
              }

              Group #PlayerFilterRow {
                LayoutMode: Left;
                Anchor: (Height: 34, Bottom: 8);

                $C.@DropdownBox #PlayerFilter {
                  Anchor: (Width: 200, Right: 6);
                }

                $C.@TextField #PlayerSearch {
                  FlexWeight: 1;
                }

                Label #PlayerCount {
                  Style: @CountStyle;
                  Anchor: (Width: 110, Left: 10);
                }

                $C.@SmallTertiaryTextButton #PlayerChat {
                  @Text = %controlcore.ui.players.recentChat;
                  Anchor: (Width: 150, Height: 32, Left: 6);
                }

                $C.@SmallSecondaryTextButton #PlayerActionNew {
                  @Text = %controlcore.ui.players.newAction;
                  Anchor: (Width: 210, Height: 32, Left: 6);
                }
              }

              Label #BansEmpty {
                Text: %controlcore.ui.bans.empty;
                Style: @NoteStyle;
                Visible: false;
              }

              Group #BanList {
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
                Anchor: (Height: 400);
                Padding: (Right: 10);
              }

              Group #PlayerDetails {
                LayoutMode: Top;
                Visible: false;

                Group {
                  LayoutMode: Left;
                  Anchor: (Height: 34, Bottom: 8);

                  $C.@SmallTertiaryTextButton #PlayerDetailsBack {
                    @Text = %controlcore.ui.players.back;
                    Anchor: (Width: 120, Height: 32);
                  }

                  Label #PlayerDetailsTitle {
                    Style: (...@SubsectionTitleStyle, FontSize: 15, VerticalAlignment: Center);
                    Anchor: (Left: 12);
                    FlexWeight: 1;
                  }
                }

                Group #PlayerDetailsBody {
                  LayoutMode: TopScrolling;
                  ScrollbarStyle: $C.@DefaultScrollbarStyle;
                  Anchor: (Height: 470);
                  Padding: (Right: 10);
                }
              }
            }
          }

          Group #SettingsTab {
            LayoutMode: Top;
            Visible: false;

            Label {
              Text: %controlcore.ui.settings.intro;
              Style: @NoteStyle;
              Anchor: (Bottom: 8);
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 34, Bottom: 8);

              $C.@DropdownBox #SettingsSearchFilter {
                Anchor: (Width: 150, Right: 6);
              }

              $C.@DropdownBox #SettingsSearchMatch {
                Anchor: (Width: 170, Right: 6);
              }

              $C.@TextField #SettingsSearch {
                FlexWeight: 1;
              }

              Label #SettingsStatus {
                Style: @CountStyle;
                Anchor: (Width: 120, Left: 10);
              }

              $C.@SmallTertiaryTextButton #SettingsSearchDefaults {
                @Text = %controlcore.ui.restoreDefaults;
                Anchor: (Width: 190, Height: 32, Left: 6);
              }
            }


            Group #SettingsList {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              Anchor: (Height: 580);
              Padding: (Right: 10);
            }
          }

          Group #PlayerTab {
            LayoutMode: Top;
            Visible: false;

            Label {
              Text: %controlcore.ui.prefs.intro;
              Style: @NoteStyle;
              Anchor: (Bottom: 8);
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 34, Bottom: 8);

              $C.@DropdownBox #PlayerSearchFilter {
                Anchor: (Width: 150, Right: 6);
              }

              $C.@DropdownBox #PlayerSearchMatch {
                Anchor: (Width: 170, Right: 6);
              }

              $C.@TextField #PlayerSearch {
                FlexWeight: 1;
              }

              Label #PlayerStatus {
                Style: @CountStyle;
                Anchor: (Width: 120, Left: 10);
              }

              $C.@SmallTertiaryTextButton #PlayerSearchDefaults {
                @Text = %controlcore.ui.restoreDefaults;
                Anchor: (Width: 190, Height: 32, Left: 6);
              }
            }


            Group #PlayerList {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              Anchor: (Height: 580);
              Padding: (Right: 10);
            }
          }

          Group #KeymapTab {
            LayoutMode: Top;
            Visible: false;

            Group #KeymapModeButtons {
              LayoutMode: Left;
              Visible: false;
              Anchor: (Height: 32, Bottom: 10);

              TextButton #KeymapModeServer {
                Text: %controlcore.ui.keymaps.modeServer;
                Style: @SegmentStyle;
                Anchor: (Width: 200, Right: 2);
              }

              TextButton #KeymapModeMine {
                Text: %controlcore.ui.keymaps.modeMine;
                Style: @SegmentStyle;
                Anchor: (Width: 160);
              }

              Group {
                FlexWeight: 1;
              }

              $C.@SmallSecondaryTextButton #NewBindToggle {
                @Text = %controlcore.ui.bind.new;
                Anchor: (Width: 170, Height: 32);
              }
            }

            Group #ServerKeymaps {
              LayoutMode: Top;
              Visible: false;

              Label {
                Text: %controlcore.ui.keymaps.serverIntro;
                Style: @NoteStyle;
                Anchor: (Bottom: 8);
              }

              Group #CustomBindForm {
                LayoutMode: Top;
                Visible: false;
                Anchor: (Bottom: 10);
                Background: #182a37;
                Padding: (Full: 10);

                Label {
                  Text: %controlcore.ui.bind.title;
                  Style: @SubsectionTitleStyle;
                  Anchor: (Height: 20, Bottom: 6);
                }

                Group {
                  LayoutMode: Left;
                  Anchor: (Height: 38);

                  $C.@TextField #NewBindName {
                    Anchor: (Width: 200, Right: 6);
                  }

                  $C.@DropdownBox #NewBindHold {
                    Anchor: (Width: 150, Right: 6);
                  }

                  $C.@DropdownBox #NewBindKey {
                    Anchor: (Width: 180, Right: 6);
                  }

                  $C.@TextField #NewBindCommand {
                    FlexWeight: 1;
                  }
                }

                Group {
                  LayoutMode: Left;
                  Anchor: (Height: 34, Top: 4);

                  $C.@CheckBox #NewBindAsServer {
                    Anchor: (Width: 26, Height: 26, Right: 8);
                  }

                  Label {
                    Text: %controlcore.ui.bind.asServer;
                    FlexWeight: 1;
                    Style: @NoteStyle;
                  }

                  $C.@SmallSecondaryTextButton #NewBindAdd {
                    @Text = %controlcore.ui.bind.save;
                    Anchor: (Width: 150, Height: 32, Left: 6);
                  }
                }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 34, Bottom: 8);

                $C.@DropdownBox #ServerKeymapSearchFilter {
                  Anchor: (Width: 150, Right: 6);
                }

                $C.@DropdownBox #ServerKeymapSearchMatch {
                  Anchor: (Width: 170, Right: 6);
                }

                $C.@TextField #ServerKeymapSearch {
                  FlexWeight: 1;
                }

                Label #ServerKeymapStatus {
                  Style: @CountStyle;
                  Anchor: (Width: 120, Left: 10);
                }

                $C.@SmallTertiaryTextButton #ServerKeymapSearchDefaults {
                  @Text = %controlcore.ui.restoreDefaults;
                  Anchor: (Width: 190, Height: 32, Left: 6);
                }
              }


              Group #ServerKeymapList {
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
                Anchor: (Height: 494);
                Padding: (Right: 10);
              }

              Group #DebugTools {
                LayoutMode: Left;
                Visible: false;
                Anchor: (Height: 34, Top: 8);

                Label {
                  Text: %controlcore.ui.debug.title;
                  FlexWeight: 1;
                  Style: @FooterStyle;
                }

                $C.@SmallTertiaryTextButton #ProbeToggle {
                  @Text = %controlcore.ui.debug.probe;
                  Anchor: (Width: 230, Height: 32, Left: 6);
                }

                $C.@SmallTertiaryTextButton #KeyTest {
                  @Text = %controlcore.ui.debug.keyTest;
                  Anchor: (Width: 230, Height: 32, Left: 6);
                }
              }
            }

            Group #MyKeymaps {
              LayoutMode: Top;

              Label {
                Text: %controlcore.ui.keymaps.mineIntro;
                Style: @NoteStyle;
                Anchor: (Bottom: 8);
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 34, Bottom: 8);

                $C.@DropdownBox #KeymapSearchFilter {
                  Anchor: (Width: 150, Right: 6);
                }

                $C.@DropdownBox #KeymapSearchMatch {
                  Anchor: (Width: 170, Right: 6);
                }

                $C.@TextField #KeymapSearch {
                  FlexWeight: 1;
                }

                Label #KeymapStatus {
                  Style: @CountStyle;
                  Anchor: (Width: 120, Left: 10);
                }

                $C.@SmallTertiaryTextButton #KeymapSearchDefaults {
                  @Text = %controlcore.ui.restoreDefaults;
                  Anchor: (Width: 190, Height: 32, Left: 6);
                }
              }


              Group #KeymapList {
                LayoutMode: TopScrolling;
                ScrollbarStyle: $C.@DefaultScrollbarStyle;
                Anchor: (Height: 580);
                Padding: (Right: 10);
              }
            }
          }

          Group #ModsTab {
            LayoutMode: Top;
            Visible: false;

            Group #ModsListView {
            LayoutMode: Top;

            Label {
              Text: %controlcore.ui.mods.intro;
              Style: @NoteStyle;
              Anchor: (Bottom: 8);
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 34, Bottom: 8);

              $C.@DropdownBox #ModsSearchFilter {
                Anchor: (Width: 240, Right: 6);
              }

              $C.@TextField #ModsSearch {
                FlexWeight: 1;
              }

              Label #ModsStatus {
                Style: @CountStyle;
                Anchor: (Width: 120, Left: 10);
              }
            }

            Group #ModsConfirm {
              LayoutMode: Top;
              Visible: false;
              Anchor: (Bottom: 8);
              Background: #3a2a1c;
              Padding: (Full: 10);

              Label #ModsConfirmText {
                Style: (...@BannerStyle, Wrap: true);
                Anchor: (Bottom: 8);
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 32);

                Group {
                  FlexWeight: 1;
                }

                $C.@SmallSecondaryTextButton #ModsConfirmYes {
                  @Text = %controlcore.ui.mods.confirmYes;
                  Anchor: (Width: 220, Height: 32, Right: 6);
                }

                $C.@SmallTertiaryTextButton #ModsConfirmNo {
                  @Text = %controlcore.ui.mods.confirmNo;
                  Anchor: (Width: 140, Height: 32);
                }
              }
            }

            Group #ModsList {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              Anchor: (Height: 580);
              Padding: (Right: 10);
            }
            }

          Group #ModConfigView {
            LayoutMode: Top;
            Visible: false;

            Group {
              LayoutMode: Left;
              Anchor: (Height: 34, Bottom: 6);

              $C.@SmallTertiaryTextButton #ModConfigBack {
                @Text = %controlcore.ui.mods.back;
                Anchor: (Width: 140, Height: 32, Right: 10);
              }

              Label #ModConfigTitle {
                Style: (...@NoteStyle, VerticalAlignment: Center);
              }
            }

            Group {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              Anchor: (Height: 560);
              Padding: (Right: 10);

              Label #ModConfigText {
                Padding: (Full: 12);
                Background: #13202a;
                Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #c9c3b3, Wrap: true);
              }
            }
          }

          Group #ModDetails {
            LayoutMode: Top;
            Visible: false;

            Group {
              LayoutMode: Left;
              Anchor: (Height: 34, Bottom: 6);

              $C.@SmallTertiaryTextButton #ModDetailsBack {
                @Text = %controlcore.ui.mods.back;
                Anchor: (Width: 140, Height: 32, Right: 10);
              }

              Label {
                Text: %controlcore.ui.mods.detailsTitle;
                Style: (...@NoteStyle, VerticalAlignment: Center);
              }
            }

            Group #ModDetailsHeader {
              LayoutMode: Top;
            }

            Group #ModDetailsBody {
              LayoutMode: TopScrolling;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              Anchor: (Height: 400);
              Padding: (Right: 10);

                Label {
                  Text: %controlcore.ui.mods.requires;
                  Style: @SubsectionTitleStyle;
                  Anchor: (Top: 10, Bottom: 6);
                }

                Label #MdRequiresNone {
                  Text: %controlcore.ui.mods.noneListed;
                  Style: @NoteStyle;
                  Visible: false;
                }

                Group #MdRequires {
                  LayoutMode: Top;
                }

                Label #MdRequiresMore {
                  Style: @NoteStyle;
                  Visible: false;
                }

                Label {
                  Text: %controlcore.ui.mods.canUse;
                  Style: @SubsectionTitleStyle;
                  Anchor: (Top: 10, Bottom: 6);
                }

                Label #MdCanUseNone {
                  Text: %controlcore.ui.mods.noneListed;
                  Style: @NoteStyle;
                  Visible: false;
                }

                Group #MdCanUse {
                  LayoutMode: Top;
                }

                Label #MdCanUseMore {
                  Style: @NoteStyle;
                  Visible: false;
                }

                Label {
                  Text: %controlcore.ui.mods.neededBy;
                  Style: @SubsectionTitleStyle;
                  Anchor: (Top: 10, Bottom: 6);
                }

                Label #MdNeededByNone {
                  Text: %controlcore.ui.mods.noneListed;
                  Style: @NoteStyle;
                  Visible: false;
                }

                Group #MdNeededBy {
                  LayoutMode: Top;
                }


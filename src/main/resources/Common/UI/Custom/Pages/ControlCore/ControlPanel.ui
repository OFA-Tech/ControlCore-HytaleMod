$C = "../../Common.ui";

@SectionTitleStyle = (...$C.@DefaultLabelStyle, RenderBold: true, FontSize: 18);
@SubsectionTitleStyle = (...$C.@DefaultLabelStyle, RenderBold: true, RenderUppercase: true, FontSize: 13, TextColor: #878e9c);
@NoteStyle = (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #878e9c, Wrap: true);
@RowLabelStyle = (...$C.@DefaultLabelStyle, RenderBold: true, VerticalAlignment: Center);
@RowValueStyle = (...$C.@DefaultLabelStyle, VerticalAlignment: Center, Wrap: true);
@StatusStyle = (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #E8A93B, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 760);

    #Title {
      $C.@Title {
        @Text = "ControlCore";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Group #TabButtons {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 14);

        $C.@SmallSecondaryTextButton #ServerTabButton {
          @Text = "Server Configs";
          Anchor: (Width: 160, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #SettingsTabButton {
          @Text = "Mod Settings";
          Anchor: (Width: 160, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #PlayerTabButton {
          @Text = "Player Prefs";
          Anchor: (Width: 160, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #KeymapTabButton {
          @Text = "Keymaps";
          Anchor: (Width: 160, Height: 30, Right: 6);
        }
      }

      Group #ServerTab {
        LayoutMode: Top;

        Label {
          Text: "Main Server Configuration";
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: "Every key of the server's config.json. Changes are saved straight away; some only apply after a restart, and read-only keys are edited in the file.";
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Label #ServerStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #ServerList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 340);
          Padding: (Right: 10);
        }
      }

      Group #SettingsTab {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: "Mod Settings";
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: "Server settings registered by ControlCore and other mods. Changes apply immediately.";
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Label #SettingsStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #SettingsList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 340);
          Padding: (Right: 10);
        }
      }

      Group #PlayerTab {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: "Player Preferences";
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: "Your own preferences, registered by ControlCore and other mods. Players can also use /cc-prefs.";
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Label #PlayerStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #PlayerList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 340);
          Padding: (Right: 10);
        }
      }

      Group #KeymapTab {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: "Keymaps";
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Group #KeymapModeButtons {
          LayoutMode: Left;
          Visible: false;
          Anchor: (Height: 34, Bottom: 8);

          $C.@SmallSecondaryTextButton #KeymapModeServer {
            @Text = "Server defaults";
            Anchor: (Width: 170, Height: 32, Right: 6);
          }

          $C.@SmallSecondaryTextButton #KeymapModeMine {
            @Text = "My keys";
            Anchor: (Width: 120, Height: 32);
          }
        }

        Group #ServerKeymaps {
          LayoutMode: Top;
          Visible: false;

          Label {
            Text: "Server defaults: the keys every player gets until they choose their own. Default goes back to the mod's keys. Write keys joined with +, for example ctrl+f; separate alternatives with |; none unbinds. The form adds a bind of your own; saving an existing name replaces it.";
            Style: @NoteStyle;
            Anchor: (Bottom: 8);
          }

          Group #CustomBindForm {
            LayoutMode: Top;
            Anchor: (Bottom: 8);

            Group {
              LayoutMode: Left;
              Anchor: (Height: 38);

              $C.@TextField #NewBindName {
                Anchor: (Width: 150, Right: 6);
              }

              $C.@TextField #NewBindKeys {
                Anchor: (Width: 140, Right: 6);
              }

              $C.@TextField #NewBindCommand {
                FlexWeight: 1;
              }
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 34, Top: 4);

              $C.@CheckBox #NewBindAsServer {
                Anchor: (Width: 26, Height: 26, Right: 8);
              }

              Label {
                Text: "Run as the server (only players with the keys.server permission, such as operators, can use it)";
                FlexWeight: 1;
                Style: @NoteStyle;
              }

              $C.@SmallSecondaryTextButton #NewBindAdd {
                @Text = "Save bind";
                Anchor: (Width: 110, Height: 32, Left: 6);
              }
            }
          }

          Label #ServerKeymapStatus {
            Style: @StatusStyle;
            Anchor: (Bottom: 8);
          }

          Group #ServerKeymapList {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Anchor: (Height: 220);
            Padding: (Right: 10);
          }
        }

        Group #MyKeymaps {
          LayoutMode: Top;

          Label {
            Text: "Your own key bindings; they only change for you. Default goes back to the server's keys. Write keys joined with +, for example ctrl+f or alt+3; separate alternatives with |; none unbinds. You can also use /cc-keys and /cc-bind.";
            Style: @NoteStyle;
            Anchor: (Bottom: 8);
          }

          Label #KeymapStatus {
            Style: @StatusStyle;
            Anchor: (Bottom: 8);
          }

          Group #KeymapList {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Anchor: (Height: 300);
            Padding: (Right: 10);
          }
        }
      }

      Group {
        Anchor: (Vertical: 14, Height: 1);
        Background: #5e512c;
      }

      $C.@TextButton #CloseButton {
        Text: "Close";
      }
    }
  }
}

$C.@BackButton {}

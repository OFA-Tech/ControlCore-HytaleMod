$C = "../../Common.ui";

@SectionTitleStyle = (...$C.@DefaultLabelStyle, RenderBold: true, FontSize: 18);
@SubsectionTitleStyle = (...$C.@DefaultLabelStyle, RenderBold: true, RenderUppercase: true, FontSize: 13, TextColor: #878e9c);
@NoteStyle = (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #878e9c, Wrap: true);
@RowLabelStyle = (...$C.@DefaultLabelStyle, RenderBold: true, VerticalAlignment: Center);
@RowValueStyle = (...$C.@DefaultLabelStyle, VerticalAlignment: Center, Wrap: true);
@StatusStyle = (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #E8A93B, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 760);

    #Title {
      $C.@Title {
        @Text = "ControlCore";
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Group #TabButtons {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 14);

        $C.@SmallSecondaryTextButton #ServerTabButton {
          @Text = "Server Configs";
          Anchor: (Width: 160, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #SettingsTabButton {
          @Text = "Mod Settings";
          Anchor: (Width: 160, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #PlayerTabButton {
          @Text = "Player Prefs";
          Anchor: (Width: 160, Height: 30, Right: 6);
        }

        $C.@SmallSecondaryTextButton #KeymapTabButton {
          @Text = "Keymaps";
          Anchor: (Width: 160, Height: 30, Right: 6);
        }
      }

      Group #ServerTab {
        LayoutMode: Top;

        Label {
          Text: "Main Server Configuration";
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: "Every key of the server's config.json. Changes are saved straight away; some only apply after a restart, and read-only keys are edited in the file.";
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Label #ServerStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #ServerList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 340);
          Padding: (Right: 10);
        }
      }

      Group #SettingsTab {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: "Mod Settings";
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: "Server settings registered by ControlCore and other mods. Changes apply immediately.";
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Label #SettingsStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #SettingsList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 340);
          Padding: (Right: 10);
        }
      }

      Group #PlayerTab {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: "Player Preferences";
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: "Your own preferences, registered by ControlCore and other mods. Players can also use /cc-prefs.";
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Label #PlayerStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #PlayerList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 340);
          Padding: (Right: 10);
        }
      }

      Group #KeymapTab {
        LayoutMode: Top;
        Visible: false;

        Label {
          Text: "Keymaps";
          Style: @SectionTitleStyle;
          Anchor: (Bottom: 4);
        }

        Label {
          Text: "Your key bindings. Write keys joined with +, for example ctrl+f or alt+3; separate alternatives with |; none unbinds. Players can also use /cc-keys and /cc-bind.";
          Style: @NoteStyle;
          Anchor: (Bottom: 8);
        }

        Label #KeymapStatus {
          Style: @StatusStyle;
          Anchor: (Bottom: 8);
        }

        Group #KeymapList {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Anchor: (Height: 340);
          Padding: (Right: 10);
        }
      }

      Group {
        Anchor: (Vertical: 14, Height: 1);
        Background: #5e512c;
      }

      $C.@TextButton #CloseButton {
        Text: "Close";
      }
    }
  }
}

$C.@BackButton {}

$C = "../../Common.ui";

// One colour setting: colour picker with a hex field. Appended by ControlPanelPage.
Group {
  LayoutMode: Top;
  Anchor: (Bottom: 10);

  Group {
    LayoutMode: Left;
    Anchor: (Height: 38);

    Label #Label {
      Anchor: (Width: 190, Right: 10);
      Style: (...$C.@DefaultLabelStyle, RenderBold: true, VerticalAlignment: Center, Wrap: true);
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Left;

      ColorPickerDropdownBox #Input {
        Anchor: (Width: 160, Height: 32, Top: 3);
        Format: Rgb;
        Style: $C.@DefaultColorPickerDropdownBoxStyle;
        DisplayTextField: true;
      }
    }

    $C.@SmallTertiaryTextButton #Reset {
      @Text = %controlcore.ui.default;
      Anchor: (Width: 90, Height: 32, Left: 6);
    }
  }

  Label #Description {
    Anchor: (Top: 2);
    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #878e9c, Wrap: true);
  }
}

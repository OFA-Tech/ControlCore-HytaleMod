$C = "../../Common.ui";

// One colour setting: hex field, a colour picker that fills the field, Save and Default. The server never sets the
// picker (it has no settable value); it only reads a picked colour into the field. Appended by ControlPanelPage.
Group {
  LayoutMode: Top;
  Anchor: (Bottom: 10);

  Group {
    LayoutMode: Left;
    Anchor: (Height: 38);

    Label #Label {
      Anchor: (Width: 240, Right: 10);
      Style: (...$C.@DefaultLabelStyle, RenderBold: true, VerticalAlignment: Center, Wrap: true);
    }

    ColorPickerDropdownBox #Picker {
      Anchor: (Width: 50, Height: 32, Top: 3, Right: 6);
      Format: Rgb;
      Style: $C.@DefaultColorPickerDropdownBoxStyle;
    }

    $C.@TextField #Input {
      FlexWeight: 1;
    }

    $C.@SmallSecondaryTextButton #Save {
      @Text = %controlcore.ui.save;
      Anchor: (Width: 80, Height: 32, Left: 6);
    }

    $C.@SmallTertiaryTextButton #Reset {
      @Text = %controlcore.ui.default;
      Anchor: (Width: 90, Height: 32, Left: 6);
    }
  }

  Label #Description {
    Anchor: (Top: 2);
    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #878e9c, Wrap: true);
  }
}

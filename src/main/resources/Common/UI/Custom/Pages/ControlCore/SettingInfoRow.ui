$C = "../../Common.ui";

Group {
  LayoutMode: Top;
  Padding: (Top: 8, Bottom: 0);

  Group {
    LayoutMode: Left;
    Anchor: (Height: 30);

    Group #State {
      Anchor: (Width: 18, Height: 18, Top: 6, Right: 10);
      Background: "Icons/Default.png";
    }

    Label #Label {
      Anchor: (Width: 250, Right: 10);
      Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #e9e4d6, RenderBold: true, VerticalAlignment: Center, Wrap: true);
    }

    Label #Value {
      FlexWeight: 1;
      Style: (...$C.@DefaultLabelStyle, TextColor: #c9c3b3, VerticalAlignment: Center, Wrap: true);
    }
  }

  Label #Error {
    Visible: false;
    Anchor: (Left: 28, Top: 4);
    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #e88a72, RenderBold: true, Wrap: true);
  }

  Label #Description {
    Anchor: (Left: 28, Top: 3);
    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9fb0bd, Wrap: true);
  }

  Group {
    Anchor: (Height: 1, Top: 9);
    Background: #263c4c;
  }
}

$C = "../../Common.ui";

Group {
  LayoutMode: Top;
  Padding: (Top: 8, Bottom: 0);

  Group {
    LayoutMode: Left;
    Anchor: (Height: 32);

    Label #Name {
      Anchor: (Width: 350);
      Style: (...$C.@DefaultLabelStyle, FontSize: 15, TextColor: #e9e4d6, RenderBold: true, VerticalAlignment: Center);
    }

    Label #PendingBadge {
      Text: %controlcore.ui.backups.pendingBadge;
      Visible: false;
      Anchor: (Height: 22, Top: 5, Left: 8);
      Padding: (Horizontal: 6);
      Background: #8a5a1c;
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #f2efe6, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
    }

    Group {
      FlexWeight: 1;
    }

    $C.@SmallTertiaryTextButton #Restore {
      @Text = %controlcore.ui.backups.restore;
      Anchor: (Width: 260, Height: 32, Left: 6);
    }

    $C.@SmallTertiaryTextButton #Delete {
      @Text = %controlcore.ui.backups.delete;
      Anchor: (Width: 120, Height: 32, Left: 6);
    }
  }

  Label #Info {
    Anchor: (Top: 3);
    Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #9fb0bd, Wrap: true);
  }

  Group {
    Anchor: (Height: 1, Top: 9);
    Background: #263c4c;
  }
}

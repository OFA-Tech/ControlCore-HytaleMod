# ControlCore - English (United States). Keys are read as controlcore.<key>.
# Placeholders in {braces} are filled in by ControlCore; keep them as they are.

# ---- Control panel layout ----
ui.bind.asServer = Run as the server (only players with the keys.server permission, such as operators, can use it)
ui.bind.save = Save bind
ui.close = Close
ui.default = Default
ui.edit = Edit
ui.keymaps.mineIntro = Your own key bindings; they only change for you. Default goes back to the server's keys. Write keys joined with +, for example ctrl+f or alt+3; separate alternatives with |; none unbinds. You can also use /cc-keys and /cc-bind.
ui.keymaps.modeMine = My keys
ui.keymaps.modeServer = Server defaults
ui.keymaps.serverIntro = Server defaults: the keys every player gets until they choose their own. Default goes back to the mod's keys. Write keys joined with +, for example ctrl+f; separate alternatives with |; none unbinds. The form adds a bind of your own; saving an existing name replaces it.

ui.settings.intro = Server settings registered by ControlCore and other mods. Changes apply immediately.
ui.tabs.keymaps = Keymaps
ui.tabs.modSettings = Mod Settings
ui.tabs.playerPrefs = Player Prefs
ui.tabs.serverConfigs = Server Configs
